---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({
    params: { slug: guide.data.slug },
    props: { guide }
  }));
}

const { guide } = Astro.props;
const base = import.meta.env.BASE_URL;
const destination = `${base}guides/${guide.data.slug}/`;
const canonical = new URL(destination, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={canonical} />
    <title>Redirecting to {guide.data.title}</title>
  </head>
  <body>
    <main>
      <h1>Guide moved</h1>
      <p><a href={destination}>Continue to {guide.data.title}</a>.</p>
    </main>
  </body>
</html>
