---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found | GuGuData.io Guides" description="The requested guide could not be found.">
  <section class="not-found container">
    <p>404</p>
    <h1>Page not found</h1>
    <a class="button primary" href={base}>Browse all guides</a>
  </section>
</BaseLayout>
